# Copy this file to ".env" and fill it in.

# --- Booking ---
# 1 = Campo Senior, 2 = Los Robles
COURSE_ID=1
TEE_TIME=08:30
# Backups to try (in order) if TEE_TIME is gone. Leave empty for none.
FALLBACK_TIMES=09:00,10:00
RATE=GF 18H SOCIOS
# Players (3 minimum on weekends). First one should be you.
PLAYERS=4299-1,4299,4299-c

# --- Timing ---
# Bookings open the day before at 8:00. Bot starts polling at POLL_START
# and gives up at POLL_END (local computer time).
POLL_START=07:59:45
POLL_END=08:05:00

# --- WhatsApp alerts (CallMeBot, free) ---
# Your number with country code, no + or spaces, e.g. 18095551234
WHATSAPP_PHONE=
CALLMEBOT_APIKEY=
